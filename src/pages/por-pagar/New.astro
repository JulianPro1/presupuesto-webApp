---
import Layout from '../../layouts/Layout.astro';
import PayableForm from '../../components/PayableForm.vue';
---

<Layout title="Presupuesto — Registrar cuenta por pagar">
  <div class="mx-auto flex w-full max-w-xl flex-col gap-4">
    <a
      href="/por-pagar/List"
      class="inline-flex w-fit items-center gap-1.5 text-xs font-semibold text-slate-500 transition hover:text-slate-800 sm:text-sm"
    >
      ← Volver a cuentas por pagar
    </a>
    <PayableForm client:only="vue" />
  </div>
</Layout>
