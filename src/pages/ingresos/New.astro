---
import Layout from '../../layouts/Layout.astro';
import IncomeForm from '../../components/IncomeForm.vue';
---

<Layout title="Presupuesto — Registrar ingreso">
  <div class="mx-auto flex w-full max-w-xl flex-col gap-4">
    <a
      href="/ingresos/List"
      class="inline-flex w-fit items-center gap-1.5 text-xs font-semibold text-slate-500 transition hover:text-slate-800 sm:text-sm"
    >
      ← Volver a ingresos
    </a>
    <IncomeForm client:only="vue" />
  </div>
</Layout>
